# Host Ports
CKAN_PORT_HOST=5000
NGINX_PORT_HOST=81
NGINX_SSLPORT_HOST=8443

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore

# Test database connections
TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test

# Dev settings
USE_HTTPS_FOR_DEV=false
USE_DEBUGPY_FOR_DEV=true

# CORS settings
CKAN__CORS__ORIGIN_ALLOW_ALL=true

# CKAN core
CKAN_VERSION=2.11.4
CKAN_SITE_ID=default
CKAN_SITE_URL=https://localhost:8443
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC

# Solr
SOLR_IMAGE_VERSION=2.10-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Redis
REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# Datapusher
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# NGINX
NGINX_PORT=80
NGINX_SSLPORT=443

#AUTH
CKAN__AUTH_CREATE_USER_VIA_WEB=True

# Extensions
CKAN__PLUGINS="image_view text_view datatables_view datastore hierarchy_display scheming_datasets scheming_organizations pnaig_config pnaig_user pnaig_audit envvars"

CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

# Scheming Extension
CKAN___SCHEMING__DATASET_SCHEMAS=ckanext.pnaig_config.schemas:pnaig_clima_dataset.yaml ckanext.pnaig_config.schemas:ckan_dataset.yaml
CKAN___SCHEMING__ORGANIZATION_SCHEMAS=ckanext.pnaig_config.schemas:default_org.yaml ckanext.pnaig_config.schemas:pnaig_organizations.json

# OAuth2 Server Configuration
OAUTHLIB_INSECURE_TRANSPORT=True

CKAN_PNAIG_OAUTH2_AUTHORIZATION_ENDPOINT=
CKAN_PNAIG_OAUTH2_TOKEN_ENDPOINT=
CKAN_PNAIG_OAUTH2_CLIENT_ID=
CKAN_PNAIG_OAUTH2_CLIENT_SECRET=
CKAN_PNAIG_OAUTH2_PROFILE_API_URL=
CKAN_PNAIG_OAUTH2_PROFILE_API_USER_FIELD=
CKAN_PNAIG_OAUTH2_PROFILE_API_MAIL_FIELD=
CKAN_PNAIG_OAUTH2_PROFILE_API_FULLNAME_FIELD=
#CKAN_PNAIG_OAUTH2_SCOPE="openid email profile" # OAuth2 scopes to request
CKAN_PNAIG_OAUTH2_SCOPE=
CKAN_PNAIG_OAUTH2_AUTHORIZATION_HEADER=


# PNAIG_USER Extension
CKANEXT__PNAIG_USER__EMAILER_URL=
CKANEXT__PNAIG_USER__EMAILER_MAINTAINER=
CKANEXT__PNAIG_USER__EMAILER_PASSWORD=

CKANEXT__PNAIG_USER__EMAILER_ROUTE_APPLICATION_TOKEN='login/application'
CKANEXT__PNAIG_USER__EMAILER_ROUTE_VERIFICATION_EMAIL='send/verification_email'
CKANEXT__PNAIG_USER__EMAILER_ROUTE_WELCOME_EMAIL='send/welcome_email'
CKANEXT__PNAIG_USER__EMAILER_ROUTE_INIT_SESSION_EMAIL='send/init_session_email'
CKANEXT__PNAIG_USER__EMAILER_ROUTE_PASSWORD_RESET_EMAIL='send/password_reset_email'
CKANEXT__PNAIG_USER__EMAILER_ROUTE_PASSWORD_CHANGED_EMAIL='send/password_changed_email'

CKANEXT__PNAIG_USER__APPLICATION_NAME="PNAIG"
CKANEXT__PNAIG_USER__APPLICATION_FIRMA="Instituto Geofísico del Perú"
CKANEXT__PNAIG_USER__APPLICATION_SUBDOMAIN=

# PNAIG_CONFIG Extension
CKANEXT__PNAIG_CONFIG__JWT_PRIVATE_KEY_FILE = "/srv/app/src_extensions/ckanext-pnaig-config/keys/private.pem"
CKANEXT__PNAIG_CONFIG__JWT_PUBLIC_KEY_FILE = "/srv/app/src_extensions/ckanext-pnaig-config/keys/public.pem"

# Theme
CKAN__BASE_PUBLIC_FOLDER=public-midnight-blue
CKAN__BASE_TEMPLATES_FOLDER=templates-midnight-blue

# File Management
CKAN__USE_CLASSIC_UPLOADER=False
CKAN__FILES__STORAGE__DEFAULT__TYPE = ckan:fs
CKAN__FILES__STORAGE__DEFAULT__PATH = /var/lib/ckan
CKANEXT__FILES__ENABLE_RESOURCE_MIGRATION_TEMPLATE_PATCH=True


# PNAIG-DOWNLOADS Extension
CKANEXT__PNAIG_DOWNLOADS__SYNC_MAX_BYTES=400000
CKANEXT__PNAIG_DOWNLOADS__SYNC_MAX_RESOURCES=5

# Artifact storage (pnaig_artifacts) — LocalFS, separate partition from resources.
# The envvars plugin translates CKAN___ prefix: CKAN___A__B__C -> ckan.a.b.c
CKAN___CKAN__FILES__STORAGE__PNAIG_ARTIFACTS__TYPE=ckan:fs
CKAN___CKAN__FILES__STORAGE__PNAIG_ARTIFACTS__PATH=/var/lib/ckan/artifacts
CKAN___CKAN__FILES__STORAGE__PNAIG_ARTIFACTS__INITIALIZE=true